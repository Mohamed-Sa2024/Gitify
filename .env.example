# GitHub App credentials (https://github.com/settings/apps)
GITHUB_CLIENT_ID=Iv1.replace_me
GITHUB_CLIENT_SECRET=replace_me

# Where the app lives — used for the OAuth redirect URI
APP_URL=http://localhost:3000

# 'production' enables Secure cookies. Leave 'development' for localhost.
NODE_ENV=development

# Anthropic API key — required for AI features (AI Review, Change Summary, Duplicate Radar)
ANTHROPIC_API_KEY=sk-ant-replace_me
